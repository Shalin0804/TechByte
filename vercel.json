{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/services/custom-software-development",
      "destination": "/services/software-development",
      "permanent": true
    },
    {
      "source": "/services/business-website-development",
      "destination": "/services/website-development",
      "permanent": true
    },
    {
      "source": "/services/ecommerce-development",
      "destination": "/services/website-development",
      "permanent": true
    },
    {
      "source": "/services/website-modernization",
      "destination": "/services/website-development",
      "permanent": true
    },
    {
      "source": "/services/support-and-maintenance",
      "destination": "/services/software-development",
      "permanent": true
    },
    {
      "source": "/insights/signs-your-website-needs-modernization",
      "destination": "/insights/signs-your-business-needs-software-modernization",
      "permanent": true
    },
    {
      "source": "/services/ai-automation",
      "destination": "/services/software-development",
      "permanent": true
    },
    {
      "source": "/insights/how-ai-can-improve-business-operations",
      "destination": "/insights",
      "permanent": true
    }
  ]
}